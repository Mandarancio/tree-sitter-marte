$TestApp = {
  Class = RealTimeApplication
  +Functions = {
    Class = ReferenceContainer
    +GAMTimer = {
      Class = IOGAM
      InputSignals = {
        Counter = {
          DataSource = Timer
          Type = uint32
        }
        Time = {
          Frequency = (uint32|"a//Parameters.freq")
          DataSource = Timer
          Type = uint32
        }
      }
      OutputSignals = {
        Counter = {
          DataSource = DDB1
          Type = uint32
        }
      }
    }
  }
}
